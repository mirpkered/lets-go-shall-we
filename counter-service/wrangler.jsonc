{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dark-scene-308e",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "FEEDBACK_FROM": "contact@mirpworks.com"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  },
  "durable_objects": {
    "bindings": [
      { "name": "COMPLETION_COUNTER", "class_name": "CompletionCounter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CompletionCounter"] }
  ]
}
