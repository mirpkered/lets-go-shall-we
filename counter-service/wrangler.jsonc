{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lets-go-shall-we-counter",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "COMPLETION_COUNTER", "class_name": "CompletionCounter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CompletionCounter"] }
  ]
}
